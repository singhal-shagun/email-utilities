# Copy to .env (shared defaults) or .env.local (personal overrides, gitignored).
# Real environment variables always win over these files.
# Lookup: <script-dir>/.env, <script-dir>/.env.local, then ./​.env, ./.env.local.

# --- Required ---
SMTP_HOST=smtp.example.com
FROM_ADDRESS=you@example.com
TO_ADDRESSES=recipient@example.com

# --- Auth (leave empty for local relays like MailHog) ---
SMTP_USERNAME=
SMTP_PASSWORD=

# --- Optional ---
SMTP_PORT=587
# Comma/semicolon/newline separated. ':' is NOT a separator (Windows paths).
# EMAIL_CC=
# EMAIL_BCC=
EMAIL_SUBJECT=Test email with attachments
EMAIL_BODY=Hello, this is a test email sent via SMTP with multiple attachments.
# EMAIL_ATTACHMENTS=./file1.pdf; ./file2.png
EMAIL_USE_STARTTLS=true
# EMAIL_USE_SSL=false  # auto-true on port 465 if unset
SMTP_TIMEOUT=30

# --- Bulk personalized sends (send_bulk.py) ---
# BULK_EXCEL=guests.xlsx
# BULK_SUBJECT=You are invited!
# BULK_BODY=Dear [RECIPIENT_NAME], ...
# BULK_BODY_FILE=body_template.txt
# BULK_BODY_HTML_FILE=body_template.html
# BULK_ATTACHMENTS_DIR=./invites
# BULK_DELAY_SECONDS=1
# BULK_DRY_RUN=true
# BULK_CC=cc@example.com (or reuse EMAIL_CC above)
# BULK_BCC=bcc@example.com (or reuse EMAIL_BCC above)
